<?xml version="1.0" encoding="utf-8"?>
<!-- https-only：禁止明文流量，LLM 端点只允许 https（LlmClient 亦在代码里校验）。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

# 功能: 服务注册清单 — 一个服务商的能力声明
# 作用: 凭此向系统请求权限(不面对用户);声明飞地类型与数据视图
# 原则: 软件不安装只注册,零字节落盘,能力按需召唤
{
  "service": "transcode",
  "vendor": "example-vendor",
  "capabilities": ["ffmpeg:encode"],
  "enclave": "tee:sev",
  "statefulness": "none",
  "data_view": "purpose-limited, contract-scoped",
  "billing": "per-second"
}

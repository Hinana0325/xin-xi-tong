# 功能: 常设令状 — 持续性意图的授权载体(物联网端)
# 作用: 声明式窄范围授权;运行中靠心跳持续证明存活,失证即死
# 区别: ≠ 常驻权限 — 四属性硬编码在状内,到期自动死亡
{
  "type": "standing",
  "intent": "上报室温并按 20°C 目标调节",
  "scope": {
    "data": ["sensor://livingroom/temperature"],
    "actuators": ["hvac://livingroom"]
  },
  "budget": { "writes_per_hour": 240 },
  "expiry": "2027-08-28T00:00:00Z",
  "proof": { "type": "heartbeat", "interval_min": 15 },
  "revocation_handle": "PLACEHOLDER",
  "user_sig": "PLACEHOLDER"
}

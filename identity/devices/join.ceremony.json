# 功能: 设备入网仪式 — 新端点加入联邦的授权流程
# 作用: 新设备无历史、无密钥,须由签名锚现场授予身份,血统自入网起算

{
  "ceremony": "device-join",
  "steps": [
    "1. 新设备经引导链自证完整性(PCR 度量,boot.chain)",
    "2. 用户在锚设备确认『允许入网』(consent.rules 呈报)",
    "3. 锚签发设备证书: dev-key + 席位声明,写入 mesh/peers/",
    "4. 设备领受常设令状(若有),开始心跳",
    "5. 全事件写 ledger,lineage = 入网证书哈希"
  ],
  "revoke": "设备除名 = 吊销其证书血统,席位记录保留供审计",
  "note": "设备无主权 — 它的权限永远来自锚的签发与用户确认"
}
